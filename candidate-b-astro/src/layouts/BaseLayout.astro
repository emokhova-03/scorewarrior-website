---
// Self-hosted Inter, imported before our own styles so the @font-face rules
// are in place by the time tokens.css names the family. Self-hosting is also
// what lets public/_headers keep `default-src 'self'`: the woff2 files are
// served from our own origin, so no font-src exception is needed.
import "@fontsource-variable/inter";

import "../styles/tokens.css";
import "../styles/global.css";
import Header from "../components/siteHeader.astro";
import Footer from "../components/siteFooter.astro";

interface Props {
  title: string;
  description?: string;
  headerVariant?: "solid" | "over";
  noindex?: boolean;
  ogImage?: string;
}

const {
  title,
  description = "Exciting game. Uniting players.",
  headerVariant = "solid",
  noindex = false,
  ogImage,
} = Astro.props;

// Build the canonical URL from the configured site URL rather than Astro.url.
// This prevents preview deployments from becoming the canonical version
// that search engines consider the primary page.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;

const resolvedOgImage = new URL(
  ogImage ?? "/og-default.png",
  Astro.site ?? Astro.url,
).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />

    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Scorewarrior" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0a0818" />

    <slot name="head" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <Header variant={headerVariant} />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
