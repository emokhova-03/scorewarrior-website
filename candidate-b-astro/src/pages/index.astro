---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { img } from "../lib/images";

/**
 * The original's home page is the hero and nothing else — .section_header5
 * followed by an empty .section_space spacer — so this page stays single
 * section rather than gaining anything the original does not have.
 *
 * Copy is the original's, verbatim, including the <strong> around "the".
 */
---

<BaseLayout
  title="Scorewarrior"
  description="Exciting game. Uniting players. Scorewarrior is a game development studio in Limassol, Cyprus."
>
  <section class="hero">
    <Image
      class="hero-bg"
      src={img("game/art-3")}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
    />

    <div class="container hero-inner">
      <div class="hero-copy">
        <h1>
          We create our game with <strong>the</strong> mission to unite and
          excite people all over the world.
        </h1>

        <p class="lead">
          Our game development studio is headquartered in Cyprus, where we focus
          on Total Battle, a top 10 mid-core 4X Strategy game. The key to our
          game is players socializing and making new friends worldwide in the
          fantasy world that we passionately create for them!
        </p>

        <p class="actions">
          <a class="button" href="/company">Learn more &rarr;</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /**
   * .section_header5 { position: relative } wrapping
   * .header-100vh { min-height: 100vh; max-height: 60rem; align-items: center }
   *
   * min() rather than a hard max-height: the effect is the same 100vh capped at
   * 60rem, but a max-height on a box whose content can grow taller — long text
   * at 360px, or large type — would clip instead of scroll.
   *
   * svh rather than vh so mobile browser chrome cannot make the hero taller
   * than the visible viewport.
   */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: center;
    min-height: min(100svh, 60rem);

    /**
     * The original pads .padding-section-large, i.e. 7rem, symmetrically and
     * centres the content inside 100vh. At desktop that 7rem (112px) already
     * exceeds the 96px the fixed header occupies, so the header overlaps only
     * padding. Below 767px the original's padding drops to 4rem (64px) while
     * the header still needs 84px — so the clearance is taken as a floor here
     * rather than trusting the padding to cover it.
     */
    padding-block: max(
        var(--section-large),
        calc(var(--header-space) + var(--space-xsmall))
      )
      var(--section-large);

    /* Everything in the hero sits on the art, so light text throughout.
       .text-color-white on both the heading and the lead. */
    --c-text: var(--white);
    color: var(--c-text);
  }

  /* .header5_background-image */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /**
   * The scrim. The original stacks .cta4_background-image-wrapper, whose own
   * background is linear-gradient(#00000080, #00000080), with an
   * .image-overlay-layer of #00000080 painted above the image — so what
   * actually lands on the art is one flat 50% black, not a directional
   * gradient. The previous version invented a three-stop diagonal gradient.
   */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(0 0 0 / 50%);
  }

  /* .max-width-medium — the text block, not the section, is what is clamped */
  .hero-copy {
    max-width: var(--mw-medium);
  }

  /**
   * The h1 carries .heading-style-h2 on the original, so it is the h2 step —
   * 3rem, stepping to 2.75rem at 991px and 2.25rem at 767px — not the 3.5rem
   * an h1 would otherwise get.
   */
  h1 {
    font-size: var(--fs-h2);
    font-weight: var(--fw-bold);
    line-height: var(--lh-heading);
  }

  /* <strong> inside a heading that is already 700 should not go heavier. */
  h1 strong {
    font-weight: inherit;
  }

  /* .margin-bottom.margin-small below the heading; .text-size-medium-2 lead,
     white rather than muted. */
  .lead {
    margin-top: var(--space-small);
    font-size: var(--fs-medium);
  }

  /* .margin-top.margin-medium wrapping .button-group */
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xsmall);
    margin-top: var(--space-medium);
  }

  /* .button-2.is-secondary.is-alternate — white border and text on transparent */
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.75rem var(--space-small);
    border: 1px solid var(--white);
    border-radius: var(--radius);
    color: var(--white);
    text-align: center;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  /**
   * The original defines no hover state for this variant. A primary call to
   * action with no pointer feedback is worse than a small divergence, so it
   * inverts on hover and focus.
   */
  .button:hover,
  .button:focus-visible {
    background: var(--white);
    color: var(--black);
  }
</style>
