---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { img } from "../lib/images";
---

<BaseLayout
  title="Scorewarrior"
  description="Exciting game. Uniting players. Scorewarrior is a game development studio in Limassol, Cyprus."
  headerVariant="over"
>
  <section class="hero">
    <Image
      class="hero-bg"
      src={img("game/art-3")}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
    />

    <div class="container hero-inner">
      <h1>
        We create our game with <em>the</em> mission to unite and excite people all
        over the world.
      </h1>

      <p class="lead">
        Our game development studio is headquartered in Cyprus, where we focus
        on Total Battle, a top 10 mid-core 4X Strategy game. The key to our game
        is players socializing and making new friends worldwide in the fantasy
        world that we passionately create for them!
      </p>

      <a class="cta" href="/company">
        Learn more <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: center;
    min-height: min(86svh, 820px);
    padding-block: calc(var(--header-space) + var(--s-9)) var(--s-9);

    /* Локальная тёмная тема поверх арта.
       Переопределяем токены, а не переписываем правила. */
    --c-text: #ffffff;
    --c-text-muted: rgba(255, 255, 255, 0.82);
    --c-border: rgba(255, 255, 255, 0.45);
    --c-bg-elevated: rgba(255, 255, 255, 0.14);

    color: var(--c-text);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Подложка: без неё белый текст читается не на всех участках арта */
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      rgba(8, 6, 20, 0.5) 0%,
      rgba(8, 6, 20, 0.22) 45%,
      rgba(8, 6, 20, 0) 78%
    );
  }

  @media (max-width: 860px) {
    .hero::after {
      background: linear-gradient(
        180deg,
        rgba(8, 6, 20, 0.72) 0%,
        rgba(8, 6, 20, 0.62) 60%,
        rgba(8, 6, 20, 0.72) 100%
      );
    }
  }

  .hero-inner {
    display: grid;
    gap: var(--s-6);
    justify-items: start;
  }

  h1 {
    font-size: var(--fs-700);
    line-height: var(--lh-tight);
    max-width: 18ch;
  }
  h1 {
    max-width: 28ch;
  }

  h1 em {
    font-style: normal;
  }

  .lead {
    font-size: var(--fs-300);
    color: var(--c-text-muted);
    max-width: 58ch;
  }

  .cta {
    padding: var(--s-3) var(--s-5);
    border: 1px solid var(--c-border);
    border-radius: var(--radius);
    transition:
      border-color var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .cta:hover,
  .cta:focus-visible {
    border-color: var(--c-text);
    background: var(--c-bg-elevated);
  }
</style>
