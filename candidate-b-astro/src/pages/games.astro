---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/sections/Section.astro";
import Gallery from "../components/sections/Gallery.astro";
import { byOrder } from "../lib/collections";

const art = byOrder(await getCollection("gameArt"));

// Три ссылки, которые не меняются и никем, кроме разработчика,
// не правятся. Коллекция здесь была бы лишней сущностью.
//
// Glyphs are the original's own, inlined rather than referenced from its CDN:
// our CSP is `img-src 'self' data:`, and inlining also lets them take
// currentColor so they follow the button's accent text. `icon` names the
// variant rendered below; the paths live in the markup.
//
// URLs match the original's games page verbatim, including ?l=en on the
// Apple one — note that is a different Apple URL from the footer's.
const stores = [
  {
    label: "Google Play",
    href: "https://play.google.com/store/apps/details?id=com.totalbattle",
    icon: "play" as const,
  },
  {
    label: "App Store",
    href: "https://apps.apple.com/us/app/total-battle/id1274132545?l=en",
    icon: "apple" as const,
  },
  {
    label: "Totalbattle.com",
    href: "https://totalbattle.com",
    icon: "browser" as const,
  },
];
---

<BaseLayout
  title="Games x Scorewarrior"
  description="Total Battle — a cross-platform MMO strategy game by Scorewarrior."
>
  <Section first headingLevel="h1" title="Total Battle" align="start" size="h3">
    {
      /*
      .product-header6_price-wrapper — "Free to play", a 1px rule, then the
      stars and the review count. The original draws five glyphs: four full
      and one half, which is how 4.5 is shown. Both shapes are its own paths,
      inlined with currentColor; they are not CDN images, and a hotlink would
      be blocked by img-src 'self' regardless.
    */
    }
    <div class="meta">
      <p class="price">Free to play</p>

      <span class="divider" aria-hidden="true"></span>

      <p class="reviews">
        <span class="stars" role="img" aria-label="4.5 out of 5">
          {
            [1, 2, 3, 4].map(() => (
              <svg
                class="star"
                viewBox="0 0 20 20"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M0.201432 8.35425C0.0324796 8.23123 -0.0397528 8.01452 0.021606 7.81473L0.101529 7.56496C0.159961 7.36756 0.335635 7.22781 0.541103 7.21527L6.92493 6.70573L9.37256 0.821007C9.45466 0.614853 9.66074 0.485543 9.88206 0.501294H10.1418C10.3505 0.496866 10.539 0.62523 10.6114 0.821007L13.069 6.70573L19.4528 7.21527C19.6583 7.22781 19.8339 7.36756 19.8924 7.56496L19.9723 7.81473C20.0403 8.00821 19.9805 8.22355 19.8224 8.35425L15.0071 12.4905L16.4857 18.695C16.5344 18.8936 16.4596 19.1021 16.2959 19.2245L16.0061 19.3843C15.8371 19.4986 15.6157 19.4986 15.4467 19.3843L10.0119 16.0873L4.54723 19.4143C4.37823 19.5286 4.15676 19.5286 3.98777 19.4143L3.76798 19.2645C3.60419 19.142 3.52945 18.9335 3.57816 18.7349L5.01677 12.4905L0.201432 8.35425Z"
                  fill="currentColor"
                />
              </svg>
            ))
          }

          {
            /* The half star — an evenodd inner subpath leaves the right side hollow. */
          }
          <svg class="star" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M19.8928 7.56999L19.9725 7.81999C20.0381 8.00868 19.9829 8.21839 19.8329 8.34999L14.9863 12.5L16.4223 18.72C16.4709 18.9188 16.3963 19.1275 16.2328 19.25L16.0134 19.4C15.9282 19.467 15.8225 19.5023 15.7143 19.5C15.6229 19.5019 15.533 19.4776 15.455 19.43L9.99999 16.1L4.57492 19.43C4.49692 19.4776 4.40695 19.5019 4.31563 19.5C4.20738 19.5023 4.10167 19.467 4.01646 19.4L3.76714 19.25C3.60364 19.1275 3.52904 18.9188 3.57766 18.72L5.01371 12.5L0.177024 8.35999C0.0192942 8.22917 -0.0404113 8.01364 0.027436 7.81999L0.137134 7.56999C0.195462 7.37241 0.370823 7.23254 0.575926 7.21999L6.94839 6.70999L9.39166 0.819989C9.46995 0.624384 9.66017 0.497222 9.87035 0.499989H10.1296C10.3379 0.495557 10.5261 0.624037 10.5983 0.819989L13.0815 6.70999L19.454 7.21999C19.6591 7.23254 19.8344 7.37241 19.8928 7.56999ZM14.1087 16.56L12.9918 11.88L16.6517 8.74999L11.8549 8.36999L9.99999 3.90999V14.05L14.1087 16.56Z"
              fill="currentColor"></path>
          </svg>
        </span>

        <span class="reviews-text">(4.5 stars) &bull; 250k+ reviews</span>
      </p>
    </div>

    <div class="body">
      <p>
        We proudly present our current flagship game — Total Battle, an MMO
        strategy game in an amazing fantasy world.
      </p>

      <p>
        In 2017 we launched the game globally, focusing on the web browser as
        the main platform.
      </p>

      <p>
        A bit later, we launched Total Battle on mobile platforms: Google Play
        and the Apple App Store, making the game a unique cross-platform MMO
        whereby players can access the game on multiple platforms with the same
        game progress.
      </p>
    </div>

    {/* .product-header6_option — label above a centred row of buttons */}
    <div class="option">
      <p class="play">Play now for free:</p>

      <ul class="stores">
        {
          stores.map((store) => (
            <li>
              <a
                class="store"
                href={store.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="store-icon" aria-hidden="true">
                  {store.icon === "play" && (
                    <svg viewBox="0 0 24 24">
                      <path
                        d="M12.954 11.616l2.957-2.957L6.36 3.291c-.633-.342-1.226-.39-1.746-.016l8.34 8.341zm3.461 3.462l3.074-1.729c.6-.336.929-.812.929-1.34c0-.527-.329-1.004-.928-1.34l-2.783-1.563l-3.133 3.132l2.841 2.84zM4.1 4.002c-.064.197-.1.417-.1.658v14.705c0 .381.084.709.236.97l8.097-8.098L4.1 4.002zm8.854 8.855L4.902 20.91c.154.059.32.09.495.09c.312 0 .637-.092.968-.276l9.255-5.197l-2.666-2.67z"
                        fill="currentColor"
                      />
                    </svg>
                  )}

                  {store.icon === "apple" && (
                    <svg viewBox="0 0 256 256">
                      <path
                        fill="currentColor"
                        d="M244 168a12 12 0 0 1-12 12h-31.3l17.6 29.9a11.9 11.9 0 0 1-4.2 16.4a11.3 11.3 0 0 1-6.1 1.7a11.9 11.9 0 0 1-10.3-5.9L140.9 126a12 12 0 0 1 20.7-12.2l24.9 42.2H232a12 12 0 0 1 12 12Zm-110.8-12H97.4l64.9-109.9a12 12 0 0 0-20.6-12.2L128 57l-13.7-23.1a12 12 0 1 0-20.6 12.2l20.4 34.5L69.5 156H24a12 12 0 0 0 0 24h109.2a12 12 0 0 0 0-24Zm-74.4 41.7a11.9 11.9 0 0 0-16.4 4.2l-4.7 8a11.9 11.9 0 0 0 4.2 16.4A11.3 11.3 0 0 0 48 228a11.9 11.9 0 0 0 10.3-5.9l4.8-8a12 12 0 0 0-4.3-16.4Z"
                      />
                    </svg>
                  )}

                  {store.icon === "browser" && (
                    <svg viewBox="0 0 24 24">
                      <g
                        fill="none"
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                      >
                        <rect width="16" height="16" x="4" y="4" rx="1" />
                        <path d="M4 8h16M8 4v4" />
                      </g>
                    </svg>
                  )}
                </span>

                <span>{store.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section>
    <Gallery
      label="Total Battle artwork"
      slides={art.map((entry) => entry.data)}
    />
  </Section>
</BaseLayout>

<style>
  /* .product-header6_price-wrapper { display: flex } — column at ≤479px */
  .meta {
    display: flex;
    align-items: center;
    margin-bottom: var(--space-medium);
  }

  /**
   * .heading-style-h5.text-color-gray500 — 1.5rem, weight 700, muted.
   * Note it is not a pill: ours had a --c-border outline the original has
   * nowhere near this element.
   */
  .price {
    color: var(--c-text-muted);
    font-size: var(--fs-h5);
    font-weight: var(--fw-bold);
    line-height: var(--lh-h5);
  }

  /* .product-header6_text-divider — 1px black rule, 1rem either side */
  .divider {
    align-self: stretch;
    width: 1px;
    margin-inline: var(--space-xsmall);
    background: var(--black);
  }

  /* .product-header6_reviews-wrapper */
  .reviews {
    display: flex;
    align-items: center;
  }

  /* .product-header6_rating-wrapper { display: flex; margin-right: .5rem } */
  .stars {
    display: flex;
    margin-right: var(--space-xxsmall);
  }

  /* .product-header6_rating-icon — 1rem square, accent, .25rem apart */
  .star {
    flex: none;
    width: 1rem;
    height: 1rem;
    margin-right: var(--space-tiny);
    color: var(--c-accent);
  }

  /* .text-size-small.text-color-gray500 */
  .reviews-text {
    color: var(--c-text-muted);
    font-size: var(--fs-small);
  }

  /* The original stacks this row on the smallest screens. */
  @media screen and (max-width: 479px) {
    .meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xxsmall);
    }

    .divider {
      display: none;
    }
  }

  .body {
    display: grid;
    gap: var(--s-4);
    max-width: 62ch;
    color: var(--c-text-muted);
    font-size: var(--fs-300);
  }

  /* .product-header6_option { margin-bottom: 1.5rem } */
  .option {
    margin-top: var(--space-large);
    margin-bottom: var(--space-small);
  }

  /**
   * .field-label.text-weight-semibold.text-align-center.text-color-gray500
   * — semibold, muted, centred, .5rem above the buttons. The label and the
   * button row are centred inside the copy column even though the heading and
   * body text beside them are left-aligned; that is what the original does.
   */
  .play {
    margin-bottom: var(--space-xxsmall);
    color: var(--c-text-muted);
    font-weight: var(--fw-semibold);
    text-align: center;
  }

  /* .variant-button-row { display: flex; flex-wrap: wrap; gap: 1rem;
     justify-content: center } — side by side, not stacked */
  .stores {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xsmall);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /**
   * .button.is-small.is-icon — white fill, 1px accent border and accent text,
   * 1rem radius, .5rem/1.25rem padding, weight 700, with a .75rem gap to the
   * glyph. The old version was a grey --c-border outline with body-coloured
   * text and no icon.
   *
   * min-height is ours: the original's padding lands the button at 40px, under
   * the 44px floor this project holds itself to.
   */
  .store {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: var(--space-xxsmall) 1.25rem;
    background: var(--white);
    border: 1px solid var(--c-accent);
    border-radius: var(--radius);
    color: var(--c-accent);
    font-weight: var(--fw-bold);
    text-align: center;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .store:hover,
  .store:focus-visible {
    background: var(--c-accent);
    color: var(--white);
  }

  /* .icon-embed-xsmall { width: 1.5rem; height: 1.5rem } */
  .store-icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
  }

  .store-icon svg {
    width: 100%;
    height: 100%;
  }
</style>
