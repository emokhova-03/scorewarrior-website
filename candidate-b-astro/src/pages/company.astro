---
import { getCollection } from "astro:content";

import BaseLayout from "../layouts/BaseLayout.astro";
import Section from "../components/sections/Section.astro";
import LogoRow from "../components/sections/LogoRow.astro";
import QuoteCard from "../components/sections/QuoteCard.astro";
import TimelineList from "../components/sections/TimelineList.astro";
import Gallery from "../components/sections/Gallery.astro";

import { byOrder } from "../lib/collections";

const timeline = byOrder(await getCollection("timeline"));
const quotes = byOrder(await getCollection("team"));
const logos = byOrder(await getCollection("openSource"));
const gallery = byOrder(await getCollection("teamGallery"));
---

<BaseLayout
  title="Company x Scorewarrior"
  description="Scorewarrior is a game developer from Limassol, Cyprus, founded in 2015."
>
  <Section
    first
    headingLevel="h1"
    title="Exciting game. Uniting players."
    lead="Scorewarrior is a game developer from Limassol, Cyprus. The company was founded in 2015 and is focused o"
  >
    {
      /*
      Слайдер команды, на месте оригинального `gallery18` — он стоит ровно
      здесь, под заголовком и лидом первой секции.

      Тот же компонент Gallery, что на /games: одна и та же дорожка со
      scroll-snap и те же две кнопки на public/js/gallery.js. Скрипт уже
      разрешён CSP и уже привязывается один раз на экземпляр, так что второй
      слайдер на сайте не добавляет ни новых скриптов, ни новых правил.

      Секция рендерится всегда, а слайдер — только если в коллекции есть
      записи: пустая дорожка с двумя рабочими кнопками выглядела бы как
      поломка, а не как отсутствие контента.

      Слайд уже, чем на /games (420px против 720px). Там пять больших артов и
      смысл в том, чтобы смотреть на один; здесь четырнадцать фото команды, и
      при 720px секция читается как одна огромная фотография с обрезком
      следующей — галерея перестаёт выглядеть галереей. При 420px на десктопе
      видно два с половиной кадра, и сразу понятно, что это дорожка.

      widths до 840, а не до 1200 по умолчанию: исходники ровно 960px — больше
      Webflow для своего слайдера не отдаёт. Запрос 1200 заставил бы Astro
      растянуть картинку: файл тяжелее, деталей не прибавилось. 840 — это
      420px слайд на экране с двойной плотностью, то есть предел, который
      здесь имеет смысл.

      autoplay 4000 мс — значение по умолчанию у слайдеров Webflow (`data-delay`
      на элементе слайдера). Точный интервал оригинала не измерен, поэтому
      здесь именно дефолт; поправить — одна цифра. На /games автопрокрутки
      нет: там пять больших артов, и уводить их из-под читателя незачем.
    */
    }
    {
      gallery.length > 0 && (
        <Gallery
          label="The Scorewarrior team in Limassol"
          slides={gallery.map((entry) => entry.data)}
          slideWidth="min(82vw, 420px)"
          sizes="(max-width: 860px) 82vw, 420px"
          widths={[420, 640, 840]}
          autoplay={4000}
        />
      )
    }
  </Section>

  <Section title="Our story">
    <TimelineList items={timeline.map((entry) => entry.data)} />
  </Section>

  <Section
    title="We're supporting amazing Open Source projects."
    tone="muted"
    size="h6"
  >
    <LogoRow logos={logos.map((entry) => entry.data)} />
  </Section>

  <Section
    title="Let's hear from the team."
    lead="Our employees' opinions are the most important driving force behind the company."
  >
    <ul class="quotes">
      {
        quotes.map((entry) => (
          <li>
            <QuoteCard
              quote={entry.data.quote}
              name={entry.data.name}
              role={entry.data.role}
              photo={entry.data.photo}
            />
          </li>
        ))
      }
    </ul>
  </Section>
</BaseLayout>

<style>
  .quotes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-5);
  }

  @media (min-width: 720px) {
    .quotes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .quotes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
