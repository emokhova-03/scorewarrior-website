---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RoleCard from "../../components/RoleCard.astro";
import { readRolesSnapshot } from "../../lib/roles/read";

// This page is rendered on request because the list of open roles
// must stay fresh without requiring a new deployment.
export const prerender = false;

const { snapshot, source } = await readRolesSnapshot();

// Department filtering comes from the query string rather than
// client-side JavaScript.
const selected = Astro.url.searchParams.get("department");

const departments = [
  ...new Set(snapshot.roles.map((role) => role.department)),
].sort((a, b) => a.localeCompare(b));

const roles = snapshot.roles
  .filter((role) => !selected || role.department === selected)
  .sort(
    (a, b) =>
      a.department.localeCompare(b.department) ||
      a.title.localeCompare(b.title),
  );

// Cache the rendered page at Cloudflare's edge for ten minutes.
// Browsers revalidate normally, while Cloudflare may continue
// serving stale content during a background refresh.
Astro.response.headers.set(
  "cache-control",
  "public, max-age=0, s-maxage=600, stale-while-revalidate=3600",
);
---

<BaseLayout
  title="Open roles - Scorewarrior"
  description="Open roles at Scorewarrior, a game development studio in Limassol, Cyprus. Most roles are on-site."
>
  <section class="container roles">
    <p class="eyebrow">We're hiring</p>

    <h1>Open roles</h1>

    {
      /*
      "Most", not "All". One role in the list is remote, and the previous
      wording made the very first sentence on the page contradict the data
      sitting a few hundred pixels below it.
    */
    }
    <p class="lead">
      Most roles are on-site in Limassol, Cyprus.{" "}
      <a href="/company">What the studio is like</a>
    </p>

    {
      departments.length > 1 && (
        <nav class="filters" aria-label="Filter roles by department">
          <a href="/careers" aria-current={!selected ? "page" : undefined}>
            All departments
          </a>

          {departments.map((department) => (
            <a
              href={`/careers?department=${encodeURIComponent(department)}`}
              aria-current={selected === department ? "page" : undefined}
            >
              {department}
            </a>
          ))}
        </nav>
      )
    }

    {
      roles.length === 0 ? (
        <p class="empty">
          {selected
            ? "No open roles in this department right now."
            : "No open roles right now."}{" "}
          <a href="mailto:hello@scorewarrior.com">Email us</a> and we will get
          back to you when something opens.
        </p>
      ) : (
        <ul class="list">
          {roles.map((role) => (
            <li>
              <RoleCard role={role} />
            </li>
          ))}
        </ul>
      )
    }

    {
      source === "bundled" && (
        <p class="notice">
          Showing the last published list. Live data is temporarily unavailable.
        </p>
      )
    }
  </section>
</BaseLayout>

<style>
  .roles {
    padding-block: calc(var(--header-space) + var(--s-8)) var(--section-large);
  }

  /* .text-weight-semibold.text-color-gray500 above the heading, as the
     original's careers section does with "We're hiring". */
  .eyebrow {
    margin-bottom: var(--space-xxsmall);
    color: var(--c-text-muted);
    font-weight: var(--fw-semibold);
  }

  /* Headings on the original's careers page are accent-coloured, at the h2
     step rather than h1 — the visually largest heading there is 3rem. */
  h1 {
    color: var(--c-accent);
    font-size: var(--fs-h2);
    font-weight: var(--fw-bold);
    line-height: var(--lh-heading);
  }

  .lead {
    max-width: var(--mw-large);
    margin-top: var(--space-xsmall);
    color: var(--c-text-muted);
    font-size: var(--fs-medium);
  }

  .lead a {
    color: var(--c-accent);
    text-decoration: underline;
  }

  /**
   * Department filter. Plain links carrying a query string, so it works with
   * JavaScript disabled — the page is server-rendered per request and reads
   * the parameter on the server.
   */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xxsmall);
    margin-top: var(--space-medium);
  }

  /**
   * Chip states follow the original, which inverts the usual convention:
   * the unselected chips are filled with the accent colour and the selected
   * one is white with an accent border. Ours had it the other way round.
   */
  .filters a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-xsmall);
    background: var(--c-accent);
    border: 1px solid var(--c-accent);
    border-radius: var(--radius);
    color: var(--white);
    font-size: var(--fs-small);
    font-weight: var(--fw-semibold);
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .filters a:hover {
    background: var(--c-accent-strong);
    border-color: var(--c-accent-strong);
  }

  .filters a[aria-current="page"] {
    background: var(--white);
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  .filters a[aria-current="page"]:hover {
    background: var(--c-fuchsia-50);
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  /* .career23_list — two columns, 2rem apart, collapsing at 767px */
  .list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-medium);
    align-items: start;
    margin-top: var(--space-large);
    padding: 0;
    list-style: none;
  }

  .empty,
  .notice {
    margin-top: var(--space-large);
    color: var(--c-text-muted);
  }

  .empty a {
    color: var(--c-accent);
    text-decoration: underline;
  }

  .notice {
    font-size: var(--fs-small);
  }

  @media screen and (max-width: 767px) {
    .list {
      grid-template-columns: 1fr;
      gap: var(--space-small);
    }
  }
</style>
