---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { Role } from "../../lib/roles/schema";

// getStaticPaths стал async, потому что getCollection возвращает Promise.
export async function getStaticPaths() {
  const entries = await getCollection("roles");

  return entries.map((entry) => ({
    // entry.id — это slug: так его положил loader (store.set({ id: role.slug })).
    // Маршруты строятся из id коллекции, а не из отдельного чтения файла.
    params: { slug: entry.id },
    // Данные передаются в страницу пропсом, чтобы не запрашивать коллекцию
    // ещё раз внутри самой страницы.
    props: { role: entry.data },
  }));
}

interface Props {
  role: Role;
}

const { role } = Astro.props;
---

<BaseLayout
  title={`[TEST] ${role.title} - Scorewarrior`}
  description={`[TEST] Role page for ${role.title}.`}
>
  <p><a href="/careers">Back to all roles</a></p>

  <h1>{role.title}</h1>
  <p>{role.department}</p>
  <p><strong>{role.location}</strong></p>
</BaseLayout>
