---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ApplyForm from "../../components/ApplyForm.astro";
import { readRolesSnapshot } from "../../lib/roles/read";

// Server-rendered. A newly added role must get its own page
// without waiting for the next deployment.
export const prerender = false;

const { slug } = Astro.params;

const { snapshot } = await readRolesSnapshot();

const role = snapshot.roles.find((item) => item.slug === slug);

if (!role) {
  // Return a real HTTP 404 rather than a page that merely displays
  // "not found". The response status matters to search engines
  // and monitoring.
  return new Response(null, {
    status: 404,
  });
}

const applied = Astro.url.searchParams.get("applied") === "1";

const formError = Astro.url.searchParams.get("error");

/**
 * Everything the page says about where and how the role is worked comes from
 * one place, so the heading, the facts list, the meta description and the
 * structured data cannot drift apart or contradict the data.
 */
const place = role.remote ? "Remote" : role.location;
const arrangement = role.remote ? "Full-time, remote" : "Full-time, on-site";
const summary = role.remote
  ? `${role.title} at Scorewarrior, remote.`
  : `${role.title} at Scorewarrior, on-site in ${role.location}.`;

// JSON-LD for search engines such as Google Jobs.
//
// Build this as a JavaScript object rather than manually constructing
// a JSON string. JSON.stringify() will correctly escape role titles
// and other dynamic values.
const jobPosting = {
  "@context": "https://schema.org",
  "@type": "JobPosting",

  title: role.title,

  description: summary,

  // The data spells it "FullTime"; schema.org wants FULL_TIME. Mapping it
  // here keeps the fixture in the source's own vocabulary.
  employmentType: role.employmentType === "FullTime" ? "FULL_TIME" : undefined,

  ...(role.postedAt
    ? {
        datePosted: role.postedAt,
      }
    : {}),

  hiringOrganization: {
    "@type": "Organization",
    name: "Scorewarrior",
    sameAs: Astro.site?.href,
  },

  /**
   * A remote role gets TELECOMMUTE rather than a Limassol address. Claiming
   * an office location for a remote job is the same untruth as the "all roles
   * are on-site" line, just told to a search engine instead of a reader.
   */
  ...(role.remote
    ? {
        jobLocationType: "TELECOMMUTE",
      }
    : {
        jobLocation: {
          "@type": "Place",

          address: {
            "@type": "PostalAddress",
            addressLocality: "Limassol",
            addressCountry: "CY",
          },
        },
      }),
};

Astro.response.headers.set(
  "cache-control",
  "public, max-age=0, s-maxage=600, stale-while-revalidate=3600",
);
---

<BaseLayout
  title={`${role.title} - Scorewarrior`}
  description={`${summary} ${role.department} team.`}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(jobPosting)}
  />

  <article class="container role">
    <p class="back">
      <a href="/careers"> &larr; All open roles </a>
    </p>

    <h1>{role.title}</h1>

    {
      /* F2.AC1: location and studio-life link appear before the first scroll. */
    }
    <p class="location">
      <strong>{role.remote ? "Remote" : `On-site — ${role.location}`}</strong>
    </p>

    <p class="location-note">
      {
        role.remote
          ? "This role is worked remotely."
          : "We work together in one office."
      }
      <a href="/company">See what that means</a>
    </p>

    <dl class="facts">
      <dt>Department</dt>
      <dd>{role.department}</dd>

      <dt>Location</dt>
      <dd>{place}</dd>

      <dt>Type</dt>
      <dd>{arrangement}</dd>
    </dl>

    <section class="body">
      <h2>About the role</h2>

      {
        role.description ? (
          <p>{role.description}</p>
        ) : (
          <p class="placeholder">
            <strong>Description not imported.</strong> This role's title and
            details come from the public careers page; the full description
            lives in the applicant tracking system and has not been copied here.
            Nothing on this page was written on the role's behalf.
          </p>
        )
      }
    </section>

    <section id="apply" class="apply">
      <h2>Apply</h2>

      <ApplyForm role={role} applied={applied} error={formError} />
    </section>
  </article>
</BaseLayout>

<style>
  .role {
    /* .max-width-large — the original clamps long-form copy at 48rem */
    max-width: var(--mw-large);
    padding-block: calc(var(--header-space) + var(--s-8)) var(--section-large);
  }

  .back a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--c-text-muted);
    transition: color var(--dur) var(--ease);
  }

  .back a:hover {
    color: var(--c-accent);
  }

  /* Accent heading at the h3 step, matching the original's role headings */
  h1 {
    margin-top: var(--space-xxsmall);
    color: var(--c-accent);
    font-size: var(--fs-h3);
    font-weight: var(--fw-bold);
    line-height: var(--lh-heading);
  }

  /* F2.AC1 — this and the studio-life link stay above the first scroll. */
  .location {
    margin-top: var(--space-xsmall);
    font-size: var(--fs-large);
  }

  .location-note {
    margin-top: var(--space-tiny);
    color: var(--c-text-muted);
  }

  .location-note a {
    color: var(--c-accent);
    text-decoration: underline;
  }

  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-xxsmall) var(--space-small);
    margin-top: var(--space-medium);
    padding-top: var(--space-small);
    border-top: 1px solid var(--c-border);
  }

  .facts dt {
    color: var(--c-text-muted);
    font-size: var(--fs-small);
  }

  .facts dd {
    margin: 0;
  }

  .body,
  .apply {
    margin-top: var(--space-xlarge);
  }

  .body h2,
  .apply h2 {
    color: var(--c-accent);
    font-size: var(--fs-h5);
    font-weight: var(--fw-bold);
    line-height: var(--lh-h5);
  }

  .body p {
    margin-top: var(--space-xsmall);
    color: var(--c-text-muted);
  }

  /* Marked as absent content rather than dressed up as copy. */
  .placeholder {
    padding: var(--space-xsmall);
    border: 1px dashed var(--c-border);
    border-radius: var(--radius);
  }

  .placeholder strong {
    color: var(--c-text);
  }
</style>
