---
/**
 * Site header, matched to .navbar14_component on the original.
 *
 * The shape to get right: the header is not a bar in the document flow, it is
 * a pill floating over the page. On the original .navbar14_component is
 * `position: fixed; inset: 0 0 auto` with `margin: 1.5rem 5% 0`, and the pill
 * itself (.navbar14_container) has `min-height: 4.5rem` and nothing else
 * contributing height.
 *
 * That last part is why the old version rendered far too tall: it put
 * `padding-block: var(--s-4)` on the header *and* `min-height: var(--header-h)`
 * on the pill, stacking 32px onto the 72px pill for a 104px header. The pill's
 * min-height is the whole height now.
 *
 * Pages clear it with --header-space (offset + height) rather than relying on
 * the header to occupy flow space, since it no longer does.
 */

interface Props {
  /**
   * Kept for callers that already pass it. The original has a single header
   * treatment — fixed, always over the page — so both values render the same.
   */
  variant?: "solid" | "over";
}

const nav = [
  { label: "Company", href: "/company" },
  { label: "Game", href: "/games" },
  { label: "Careers", href: "/careers" },
  { label: "Contacts", href: "/contacts" },
];

const SUPPORT = "https://scorewarrior.theymes.com/hc/en/total-battle";

const path = Astro.url.pathname;

/** Marks the current section the way .w--current does on the original. */
function isCurrent(href: string): boolean {
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <!-- Затемнение страницы под открытым меню (используется вариантом «Dim»). -->
  <div class="nav-scrim" aria-hidden="true"></div>
  <div class="bar">
    <a class="logo" href="/" aria-label="Scorewarrior — home">
      <!-- Знак-треугольник слева от надписи. Декоративный: имя ссылки даёт aria-label. -->
      <img
        class="logo-mark"
        src="/brand/sw-triangle-white.svg"
        alt=""
        width="26"
        height="23"
      />
      <img
        class="logo-word"
        src="/brand/logo-scorewarrior-white.svg"
        alt="Scorewarrior"
        width="185"
        height="26"
      />
    </a>

    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span class="sr-only">Menu</span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <!-- Плавающая подсветка под пунктом при наведении (двигает nav.js). Только десктоп + мышь. -->
      <span class="nav-pill" aria-hidden="true"></span>
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a class="support" href={SUPPORT} rel="noopener">Support</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    align-items: center;
    margin-top: var(--header-offset);
    margin-inline: var(--gutter);
  }

  /* The pill. Its min-height IS the header height — nothing else adds to it. */
  .bar {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xsmall);
    width: 100%;
    max-width: var(--container);
    min-height: var(--header-h);
    margin-inline: auto;
    padding-inline: var(--space-medium);
    background: var(--c-accent);
    border-radius: var(--radius);

    /* Everything inside the pill is light, so descendants can keep using
       --c-text without knowing they sit on the accent colour. */
    --c-text: var(--c-nav-link);
    color: var(--c-text);
  }

  .logo {
    position: relative;
    display: flex;
    align-items: center;
  }

  /**
   * Правило бренда: либо знак, либо надпись, но не оба сразу.
   * Десктоп — только надпись; ≤991px (там же, где бургер) — только знак.
   *
   * Обе картинки всегда в DOM, и смена идёт кроссфейдом, а не display:none —
   * иначе знак «появляется из ниоткуда». Активная лежит в потоке и задаёт
   * ширину ссылки, неактивная — absolute, прозрачная и чуть уменьшенная.
   * Масштаб — через свойство scale (оно не конфликтует с transform).
   * Исключены из .is-resizing, поэтому переход виден (см. ниже).
   */
  .logo-mark,
  .logo-word {
    height: auto;
    transform-origin: left center;
    transition:
      opacity 280ms var(--ease-out-strong),
      scale 280ms var(--ease-out-strong);
  }

  .logo-word {
    width: 185px;
  }

  .logo-mark {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    margin-block: auto; /* вертикальное центрирование без transform */
    width: 34px;
    opacity: 0;
    scale: 0.8;
    pointer-events: none;
  }

  .nav {
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    padding: 0;
  }

  /* .navbar14_link — the spacing between links is padding, not gap */
  .nav-list a {
    display: block;
    padding: var(--space-xxsmall) var(--space-xsmall);
    font-size: var(--fs-regular);
    color: var(--c-nav-link);
    transition: color var(--dur) var(--ease);
  }

  .nav-list a:hover {
    color: var(--c-nav-link-hover);
  }

  .nav-list a[aria-current="page"] {
    color: var(--c-nav-link-current);
    font-weight: var(--fw-regular);
  }

  /**
   * «Плавающая пилюля» (как в Linear): один фон, который переезжает к пункту
   * под курсором. Включается только там, где есть настоящий hover
   * (мышь/трекпад) и десктопная ширина — на телефоне hover не существует.
   * Позицию и размер ставит nav.js через transform/width/height.
   */
  .nav-pill {
    display: none;
  }

  @media screen and (min-width: 992px) and (hover: hover) and (pointer: fine) {
    .nav {
      position: relative;
      isolation: isolate; /* пилюля z-index:0 остаётся под текстом ссылок */
    }

    .nav-list a {
      position: relative;
      z-index: 1;
    }

    /* Раньше hover просто тускнил текст; теперь это делает пилюля. */
    .nav-list a:hover {
      color: var(--c-nav-link);
    }

    .nav-pill {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      z-index: 0;
      border-radius: var(--radius); /* та же форма, что у кнопки Support */
      background: #ffffff26;
      opacity: 0;
      scale: 0.96;
      pointer-events: none;
      /* Едет по тем же правилам, что .viewport в курсе (width/height),
         но с сильным ease-out вместо ease — резкий старт, мягкая посадка. */
      transition:
        translate 250ms var(--ease-out-strong),
        width 250ms var(--ease-out-strong),
        height 250ms var(--ease-out-strong),
        scale 200ms var(--ease-out-strong),
        opacity 150ms ease;
    }

    .nav-pill.is-on {
      opacity: 1;
      scale: 1;
    }

    /* Первое появление: пилюля не «летит» из угла, а возникает на месте. */
    .nav-pill.no-move {
      transition:
        scale 200ms var(--ease-out-strong),
        opacity 150ms ease;
    }
  }

  /* .navbar14_button-wrapper { margin-left: 2rem } wrapping .button.is-small,
     which is a white pill with accent text — not an outline. */
  .support {
    margin-left: var(--space-medium);
    padding: var(--space-xxsmall) 1.25rem;
    background: var(--white);
    color: var(--c-accent);
    font-weight: var(--fw-bold);
    border-radius: var(--radius);
    white-space: nowrap;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease),
      scale 150ms var(--ease-out-strong);
  }

  /**
   * Нажатие и наведение на Support (приёмы из курса):
   *  - при нажатии кнопка чуть «вдавливается» (scale 0.97, 150 мс) — ощущение,
   *    что интерфейс живой и слышит клик;
   *  - hover (только мышь/трекпад: на телефоне наведения нет) — лёгкое
   *    сжатие 0.98 и затемнение фона; цвета меняем кривой ease, как советует
   *    курс для hover-эффектов.
   * Используем свойство scale, а не transform: на телефоне у .support свой
   * transform для каскада меню, и они бы конфликтовали.
   */
  .support:active {
    scale: 0.97;
  }

  @media (hover: hover) and (pointer: fine) {
    .support:hover {
      background: var(--c-fuchsia-100);
      scale: 0.98;
    }

    .support:hover:active {
      scale: 0.97;
    }
  }

  .burger {
    display: none;
  }

  /**
   * Locks the page behind the open panel. Global because it targets body,
   * which no scoped selector can reach; nav.js adds and removes the class.
   */
  :global(body.nav-open) {
    overflow: hidden;
  }

  /**
   * Пока меню раскрыто, «бегунок» страницы (полоса прокрутки) исчезает.
   * Раньше блокировали только body, а полоса принадлежит <html> — поэтому она
   * оставалась видна. Теперь nav.js вешает класс .nav-open ещё и на <html>:
   *  - overflow: hidden убирает полосу и саму прокрутку страницы;
   *  - scrollbar-gutter: stable оставляет место под полосу пустым, чтобы
   *    страница и шапка не прыгнули вбок на ширину полосы (на Windows и
   *    при мыши на Mac полоса занимает ~15px).
   * Без :has() — работает во всех браузерах, где есть сама полоса.
   */
  :global(html.nav-open) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  /**
   * Плавная смена «мобильная ↔ десктопная». CSS не умеет анимировать
   * переключение layout (inline-ряд ссылок ↔ выпадающая панель), поэтому
   * nav.js на мгновение вешает .is-switching, и то, что появляется в новом
   * режиме, мягко проявляется (fade + лёгкий сдвиг) вместо резкого щелчка.
   * fill-mode backwards: после анимации возвращаются обычные стили.
   */
  /**
   * Причина «дёрганья» при пересечении 991px: у мобильной панели есть свои
   * transition'ы (opacity/transform/clip-path). В момент смены режима стили
   * панели меняются с «десктопных» на «закрытая мобильная» — и браузер
   * ПЛАВНО довозит их, т.е. видно, как ряд ссылок улетает/гаснет. Пока на
   * шапке стоит .is-resizing (2 кадра, ставит nav.js), все transition
   * отключены, и смена происходит мгновенно и незаметно. Анимация
   * проявления (@keyframes ниже) — это animation, ей это правило не мешает.
   */
  :global(.site-header.is-resizing),
  :global(.site-header.is-resizing *:not(.logo-mark):not(.logo-word)),
  :global(.site-header.is-resizing *::before),
  :global(.site-header.is-resizing *::after) {
    transition: none !important;
  }

  /* Затемнение страницы: по умолчанию выключено, включает вариант «Dim». */
  .nav-scrim {
    display: none;
  }

  @keyframes sw-appear {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media screen and (min-width: 992px) {
    .is-switching .nav-list li,
    .is-switching .support {
      animation: sw-appear 320ms var(--ease-out-strong) backwards;
    }
    .is-switching .nav-list li:nth-child(2) {
      animation-delay: 30ms;
    }
    .is-switching .nav-list li:nth-child(3) {
      animation-delay: 60ms;
    }
    .is-switching .nav-list li:nth-child(4) {
      animation-delay: 90ms;
    }
    .is-switching .support {
      animation-delay: 120ms;
    }
  }

  @media screen and (max-width: 991px) {
    .is-switching .burger {
      animation: sw-appear 320ms var(--ease-out-strong) backwards;
    }
  }

  /* ---------------------------------------------------------------------
     The original collapses at 991px (data-collapse="medium"), not 860px.
     --------------------------------------------------------------------- */
  @media screen and (max-width: 991px) {
    /* .menu-icon2 — 48x48 holding three 24x2 white bars. 48px already
       clears the 44px tap-target minimum. */
    .logo-mark {
      position: static;
      opacity: 1;
      scale: 1;
      pointer-events: auto;
    }

    .logo-word {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      margin-block: auto;
      opacity: 0;
      scale: 0.9;
      pointer-events: none;
    }

    .burger {
      display: grid;
      place-content: center;
      gap: 6px;
      width: 48px;
      height: 48px;
      margin-right: -0.5rem;
      margin-left: auto;
      padding: 0;
    }

    .burger span[aria-hidden] {
      display: block;
      width: 24px;
      height: 2px;
      background: var(--c-nav-link);
      border-radius: 1px;
      transform-origin: center;
      transition:
        transform var(--dur-burger) var(--spring-snappy),
        opacity 150ms ease-out;
    }

    /* 8px = gap 6px + высота полоски 2px */
    .burger[aria-expanded="true"] span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }
    .burger[aria-expanded="true"] span:nth-child(2) {
      opacity: 0;
      transform: scaleX(0.4);
    }
    .burger[aria-expanded="true"] span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }

    /**
     * The open panel hangs off the bottom of the pill:
     * .navbar14_menu-link-wrapper is the accent colour with
     * border-radius: 0 0 1rem 1rem and padding: 1rem 2rem 2.5rem.
     * It overlaps the pill by one radius and pads back out, so the two read as
     * one shape with no seam. The panel paints *over* the pill — same as the
     * original, where .navbar14_menu sits at top: 80% with z-index: 10 — and
     * since both are --c-accent the overlap is invisible. Tucking it behind
     * with a negative z-index would also look right, but only for as long as
     * .bar never becomes a stacking context.
     */
    .nav {
      position: absolute;
      top: calc(100% - var(--radius));
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      padding: calc(var(--radius) + var(--space-xsmall)) var(--space-medium)
        2.5rem;
      background: var(--c-accent);
      border-radius: 0 0 var(--radius) var(--radius);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-8px);
      clip-path: inset(0 0 100% 0 round 0 0 var(--radius) var(--radius));
      /* Закрытие: та же пружина, но короче — выход быстрее входа. */
      transition:
        opacity 200ms ease-out,
        transform var(--dur-menu-out) var(--spring-smooth),
        clip-path var(--dur-menu-out) var(--spring-smooth);

      /**
       * The panel is absolute inside a fixed header, so anything past the
       * viewport bottom would be unreachable — there is nothing to scroll.
       * In portrait the content (≈384px at 360px wide) fits any phone, but a
       * landscape phone is only ~360px tall, and large text or zoom eats the
       * margin at any width. So the panel gets its own scroll, which is also
       * what the original does: .navbar14_menu carries `overflow: auto`.
       *
       * Available height is the viewport minus the space above the panel:
       * header offset + header height, less the radius it is pulled up by.
       * svh rather than vh so mobile browser chrome cannot push it over.
       */
      max-height: calc(
        100svh - var(--header-space) + var(--radius) - var(--space-xsmall)
      );
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .nav.is-open {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
      clip-path: inset(0 0 0 0 round 0 0 var(--radius) var(--radius));
      /* Открытие: пружина 0.5s без перелёта (как .smooth в SwiftUI). */
      transition:
        opacity 250ms ease-out,
        transform var(--dur-menu-in) var(--spring-smooth),
        clip-path var(--dur-menu-in) var(--spring-smooth);
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
    }

    /* Каскад пунктов: при открытии по очереди, при закрытии — все сразу. */
    .nav-list li,
    .support {
      opacity: 0;
      transform: translateY(-6px);
      transition:
        opacity 150ms ease-out,
        transform 150ms ease-out;
    }

    .nav.is-open .nav-list li,
    .nav.is-open .support {
      opacity: 1;
      transform: none;
      transition:
        opacity 300ms ease-out,
        transform var(--dur-menu-in) var(--spring-smooth);
    }

    .nav.is-open .nav-list li:nth-child(1) {
      transition-delay: 60ms;
    }
    .nav.is-open .nav-list li:nth-child(2) {
      transition-delay: 105ms;
    }
    .nav.is-open .nav-list li:nth-child(3) {
      transition-delay: 150ms;
    }
    .nav.is-open .nav-list li:nth-child(4) {
      transition-delay: 195ms;
    }
    .nav.is-open .support {
      transition-delay: 240ms;
    }

    /* Без движения — только прозрачность. */
    @media (prefers-reduced-motion: reduce) {
      .nav,
      .nav.is-open,
      .nav-list li,
      .support,
      .burger span[aria-hidden] {
        transform: none !important;
        clip-path: none !important;
        transition-delay: 0ms !important;
      }
    }

    /* .navbar14_link at ≤991px — padding: 1rem 0; font-size: 1.125rem.
       16 + 16 + (18 × 1.5) = 59px, comfortably over 44px. */
    .nav-list a {
      padding: var(--space-xsmall) 0;
      font-size: var(--fs-medium);
    }

    .support {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 44px;
      margin-top: var(--space-xsmall);
      margin-left: 0;
      text-align: center;
    }
  }

  /* The pill tightens below 767px: min-height 4rem, padding-inline 1.25rem.
     --header-h and --header-offset already step down in tokens.css. */
  @media screen and (max-width: 767px) {
    .bar,
    .nav {
      padding-inline: 1.25rem;
    }
  }
</style>

<!--
  is:inline keeps Astro from bundling this and re-inlining it into the HTML.
  The src makes it an external reference from our own origin, which is what
  `script-src 'self'` in public/_headers allows — an inline block is blocked
  in production and only appears to work in dev, where _headers is not applied.
-->
<script is:inline src="/js/nav.js" defer></script>
