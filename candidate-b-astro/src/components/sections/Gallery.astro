---
import { Image } from "astro:assets";
import { img } from "../../lib/images";

interface Slide {
  image: string;
  alt: string;
}
interface Props {
  slides: Slide[];
  label: string;
  /**
   * Ladder of widths to generate. Defaults to the game art on /games, whose
   * sources are ~5670px wide and can fill any of them.
   *
   * It is a prop because the team photos on /company are only 960px wide —
   * the largest variant Webflow serves for that slider. Asking for 1200 there
   * would make Astro upscale: a bigger file with no extra detail in it, paid
   * for on every visit. Never request more than the source has.
   */
  widths?: number[];
  /**
   * Width of one slide, as a CSS length. Reaches the stylesheet through a
   * custom property, which is the only way a scoped <style> block can take a
   * value from a prop.
   *
   * A prop for the same reason as `widths`: on /games there are five huge
   * artworks and one at a time is the point. /company has fourteen team
   * photos, and at 720px each the section reads as one enormous photo with a
   * sliver of the next — the gallery stops looking like a gallery.
   */
  slideWidth?: string;
  /**
   * What `sizes` tells the browser about the rendered width, so it can pick
   * from `widths` before any CSS has loaded. It has to be restated here
   * because `sizes` takes plain lengths and cannot read --slide-width; keep
   * the two in step whenever either changes.
   */
  sizes?: string;
  /**
   * Advance on its own every N milliseconds. Omit, or pass 0, for a slider
   * that only moves when asked — which stays the default, because autoplay is
   * the one feature here that takes control away from the reader.
   *
   * Opt-in per page rather than global: the value is measured from whichever
   * slider on the original is being matched, and /games has not been checked.
   */
  autoplay?: number;
}
const {
  slides,
  label,
  widths = [480, 800, 1200],
  slideWidth = "min(86vw, 720px)",
  sizes = "(max-width: 860px) 86vw, 720px",
  autoplay = 0,
} = Astro.props;

// Autoplay with one slide would scroll a track that cannot move.
const autoplays = autoplay > 0 && slides.length > 1;
---

<div
  class="gallery"
  data-gallery
  data-autoplay-delay={autoplays ? String(autoplay) : undefined}
  style={`--slide-width: ${slideWidth}`}
>
  <ul class="track" tabindex="0" aria-label={label}>
    {
      slides.map((slide) => (
        <li class="slide">
          <Image
            src={img(slide.image)}
            alt={slide.alt}
            widths={widths}
            sizes={sizes}
            loading="lazy"
          />
        </li>
      ))
    }
  </ul>

  <div class="controls">
    {
      /*
      Slide dots, matched to the original's `slide-nav`: they answer "how many
      photos are there, and where am I" — which the arrows alone cannot.

      Rendered server-side rather than built by script, so the count is
      visible even if gallery.js never runs. Like the arrows, they only become
      clickable once it does; that is the same trade-off already documented
      for the arrows, not a new one.

      They are deliberately smaller than the 44px this project holds itself
      to. WCAG's target-size rule exempts a control that has an equivalent
      alternative on the same page, and these have two: the arrows next to
      them and the track's own scroll. Fourteen 44px targets would be 616px
      wide and could not fit a 360px screen at all.
    */
    }
    {
      /* One photo needs no position indicator — and leaving the list out
         entirely keeps the row from reserving an empty grid track for it. */
      slides.length > 1 && (
        <ul class="dots" data-gallery-dots>
          {slides.map((_, index) => (
            <li>
              <button
                type="button"
                aria-current={index === 0 ? "true" : "false"}
                aria-label={`Photo ${index + 1} of ${slides.length}`}
              />
            </li>
          ))}
        </ul>
      )
    }

    <div class="arrows">
      {
        /*
        Pause control, and the reason it exists at all: WCAG 2.2.2 asks for a
        way to stop content that moves on its own for longer than five
        seconds. Hover pausing does not satisfy it — a keyboard or
        screen-reader user never hovers. The original has no such control;
        this is a deliberate addition, recorded in docs/backlog.md with the
        other divergences.

        It sits inside .arrows rather than in a track of its own, so the row
        keeps its two-group shape at every width and the dots stay centred.

        Both glyphs ship in the markup and CSS shows one, keyed off
        `data-playing`. That keeps gallery.js to flipping one attribute
        instead of building SVG at runtime.

        Rendered paused, and gallery.js starts it. Without the script nothing
        moves, so a button labelled "Pause" would be describing a state the
        page is not in.
      */
      }
      {
        autoplays && (
          <button
            type="button"
            data-gallery-autoplay
            data-playing="false"
            aria-label="Play the slideshow"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <g class="glyph-pause" fill="currentColor">
                <rect x="3" y="2" width="3.5" height="12" rx="1" />
                <rect x="9.5" y="2" width="3.5" height="12" rx="1" />
              </g>

              <path
                class="glyph-play"
                d="M4 2.2v11.6L13.5 8z"
                fill="currentColor"
              />
            </svg>
          </button>
        )
      }

      <button type="button" data-dir="-1" aria-label="Previous">
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M3.31066 8.75001L9.03033 14.4697L7.96967 15.5303L0.439339 8.00001L7.96967 0.469676L9.03033 1.53034L3.31066 7.25001L15.5 7.25L15.5 8.75L3.31066 8.75001Z"
            fill="currentColor"></path>
        </svg>
      </button>

      <button type="button" data-dir="1" aria-label="Next">
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            fill-rule="evenodd"
            clip-rule="evenodd"
            d="M12.6893 7.25L6.96967 1.53033L8.03033 0.469666L15.5607 8L8.03033 15.5303L6.96967 14.4697L12.6893 8.75H0.5V7.25H12.6893Z"
            fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .gallery {
    display: grid;
    gap: var(--s-5);
  }

  .track {
    display: flex;
    gap: var(--s-5);
    list-style: none;
    padding: 0;
    margin: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  /* Set by the component from the `slideWidth` prop; the fallback keeps the
     rule valid if the inline custom property ever goes missing. */
  .slide {
    flex: 0 0 var(--slide-width, min(86vw, 720px));
    scroll-snap-align: start;
  }

  .slide img {
    width: 100%;
    border-radius: var(--radius);
  }

  /**
   * Dots centred, arrows kept at the right edge as on the original.
   *
   * Below 720px the two stack: fourteen dots are ~310px and the arrow pair is
   * ~110px, which will not share a row on a 360px screen. Stacked, the dots
   * stay centred and the arrows stay right — the same reading, one row lower.
   */
  .controls {
    display: grid;
    gap: var(--s-4);
    align-items: center;
    grid-template-areas:
      "dots"
      "arrows";
  }

  /**
   * Three tracks with equal outer ones, so the middle track is centred on the
   * gallery rather than centred on the space the arrows leave over. The first
   * area holds nothing; it exists to balance the third.
   */
  @media (min-width: 720px) {
    .controls {
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas: "balance dots arrows";
    }
  }

  .dots {
    grid-area: dots;
    justify-self: center;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .arrows {
    grid-area: arrows;
    justify-self: end;
    display: flex;
    gap: var(--s-3);
  }

  /* The hit area, kept invisible: 20px square with the mark drawn inside it,
     so the pointer has more to aim at than the 8px dot. */
  .dots button {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }

  .dots button::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: var(--radius-circle);
    background: var(--c-gray-300);
    transition:
      background-color var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .dots button:hover::before {
    background: var(--c-gray-400);
  }

  /* aria-current is the state, and the style reads it directly rather than
     from a second class the script would have to keep in sync. One source of
     truth for "which slide is this". */
  .dots button[aria-current="true"]::before {
    background: var(--c-accent);
    transform: scale(1.25);
  }

  .dots button:focus-visible {
    outline-offset: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .dots button::before {
      transition: none;
    }
  }

  /**
   * Matched to .gallery13_arrow on the original's games page: a white circle,
   * 3.5rem across and 3rem below 991px, with a light-grey ring and the arrow
   * glyph in the accent colour.
   *
   * That glyph colour is the whole point. The ring really is #f4f4f4 on the
   * original too — `.gallery13_arrow.hide-mobile-landscape` overrides the base
   * black border with light-grey — so a near-invisible ring was never the bug.
   * What was missing is that the original's arrow mark is --dark-magenta, and
   * ours was a black fill inside an <img>, which cannot inherit a colour. The
   * glyphs are inlined now so they take currentColor.
   *
   * .shadow-medium appears on only the left arrow in the original's markup,
   * which reads as an authoring slip rather than a design; both get it here.
   */
  .arrows button {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    color: var(--c-accent);
    background: var(--white);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-circle);
    box-shadow: var(--shadow-medium);
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .arrows button:hover {
    border-color: var(--c-accent);
    background: var(--c-fuchsia-50);
  }

  /* The global :focus-visible ring is an outline, so it needs offset room to
     sit outside the circle rather than cutting across it. */
  .arrows button:focus-visible {
    outline-offset: 2px;
  }

  /**
   * One glyph at a time. `data-playing` is the whole state, written by
   * gallery.js and read here — same arrangement as `aria-current` on the dots,
   * and for the same reason: no second class to keep in sync.
   */
  .arrows button[data-playing="true"] .glyph-play,
  .arrows button[data-playing="false"] .glyph-pause {
    display: none;
  }

  /* The original steps its arrows down to 3rem here, which still clears the
     44px minimum. */
  @media screen and (max-width: 991px) {
    .arrows button {
      width: 3rem;
      height: 3rem;
    }
  }
</style>

<!-- External file, not an inline block — see the comment in public/js/nav.js. -->
<script is:inline src="/js/gallery.js" defer></script>
