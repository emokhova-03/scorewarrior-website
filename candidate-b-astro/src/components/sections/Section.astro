---
interface Props {
  eyebrow?: string;
  title?: string;
  lead?: string;
  id?: string;
  headingLevel?: "h1" | "h2";
  /**
   * Set on the first section of a page. The site header is position: fixed and
   * therefore takes no space in the flow, so whatever comes first has to clear
   * it itself or it renders underneath the floating pill.
   */
  first?: boolean;
}
const {
  eyebrow,
  title,
  lead,
  id,
  headingLevel = "h2",
  first = false,
} = Astro.props;
const Heading = headingLevel;
const hasHead = Boolean(eyebrow || title || lead);
---

<section class:list={["section", { first }]} id={id}>
  <div class="container">
    {
      hasHead && (
        <header class="head">
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && <Heading class="title">{title}</Heading>}
          {lead && <p class="lead">{lead}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>
<style>
  .section {
    padding-block: var(--s-9);
  }
  /* Same shape as the hero clearance in index.astro: the section's own
     spacing token plus the space the fixed header occupies. */
  .section.first {
    padding-top: calc(var(--header-space) + var(--s-9));
  }
  .head {
    display: grid;
    gap: var(--s-4);
    max-width: 46rem;
    margin-bottom: var(--s-8);
  }
  .eyebrow {
    font-size: var(--fs-100);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-text-muted);
  }
  .title {
    font-size: var(--fs-600);
  }
  .lead {
    font-size: var(--fs-300);
    color: var(--c-text-muted);
  }
</style>
