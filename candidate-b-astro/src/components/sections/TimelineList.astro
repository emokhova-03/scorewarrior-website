---
interface Item {
  year: string;
  text: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ol class="timeline">
  {items.map((item) => (
    <li class="row">
      <p class="year">{item.year}</p>
      <p class="text">{item.text}</p>
    </li>
  ))}
</ol>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-6);
  }

  .row {
    display: grid;
    gap: var(--s-2);
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-border);
  }

  @media (min-width: 860px) {
    .row {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: var(--s-7);
    }

    .year {
      font-size: var(--fs-400);
      color: var(--c-accent);
    }
  }

  .text {
    color: var(--c-text-muted);
    max-width: 62ch;
  }
</style>