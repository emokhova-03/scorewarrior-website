---
/**
 * A caption-less photo wall — used for the team gallery on /company.
 *
 * Deliberately not the Gallery component. Gallery is a one-slide-at-a-time
 * slider with arrow buttons, and those buttons need public/js/gallery.js;
 * the CSP in public/_headers is `script-src 'self'`, so every script is one
 * more thing that has to keep working after deploy. A wall needs no script at
 * all: the layout is CSS grid and nothing here reacts to input.
 *
 * Uniform tiles rather than the photos' own proportions. The source shots are
 * a mix of portrait and landscape, and a wall of mixed ratios reads as
 * misaligned. `aspect-ratio` fixes the tile and `object-fit: cover` crops the
 * photo into it, which also means the grid never reflows as images load.
 *
 * The list is a <ul> because it is a list of items with no reading order —
 * that is what a screen reader should hear. Each <img> carries its own alt,
 * so the wall needs no group label beyond the section heading above it.
 */
import { Image } from "astro:assets";
import { img } from "../../lib/images";

interface Photo {
  /** Key into src/assets, without extension — see lib/images.ts. */
  image: string;
  alt: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;
---

<ul class="wall">
  {
    photos.map((photo) => (
      <li class="tile">
        <Image
          src={img(photo.image)}
          alt={photo.alt}
          widths={[320, 480, 720]}
          sizes="(max-width: 719px) 45vw, (max-width: 1079px) 30vw, 280px"
          loading="lazy"
          decoding="async"
        />
      </li>
    ))
  }
</ul>

<style>
  /**
   * Two columns from 360px up. One column would make each photo nearly full
   * width on a phone and turn the section into a very long scroll; two keeps
   * it readable as a wall, and nothing here is a tap target, so the 44px
   * minimum does not apply.
   */
  .wall {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* Same two breakpoints the quote grid on /company uses, so the two
     sections step at the same widths. */
  @media (min-width: 720px) {
    .wall {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--s-5);
    }
  }

  @media (min-width: 1080px) {
    .wall {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .tile {
    /* The tile, not the image, holds the shape: it is what the grid sizes,
       and it clips the rounded corners even before the photo arrives. */
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    /* Light grey shows through while a lazy image is still loading, so the
       wall reads as a grid of tiles rather than as blank space. */
    background: var(--c-border);
  }

  /**
   * The first tile spans two columns and two rows, which gives the wall a
   * focal point instead of a flat sheet of equal squares. Only from 720px:
   * at 360px a 2x2 span would be the whole grid width and there would be no
   * wall left to look at.
   */
  @media (min-width: 720px) {
    .tile:first-child {
      grid-column: span 2;
      grid-row: span 2;
      aspect-ratio: auto;
    }
  }

  .tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
